@import "../../app.wxss";

.shipment-page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
}

.page-description {
  display: block;
  margin-top: 12rpx;
  color: #666666;
  font-size: 26rpx;
}

.scope-switch {
  display: flex;
  gap: 32rpx;
  margin-top: 32rpx;
  border-bottom: 1rpx solid #dddddd;
}

.scope-item {
  padding: 18rpx 4rpx;
  color: #777777;
  font-size: 29rpx;
}

.scope-item-active {
  border-bottom: 4rpx solid #1f1f1f;
  color: #1f1f1f;
  font-weight: 600;
}

.shipment-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.shipment-card {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.card-header {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
}

.reference {
  color: #1f1f1f;
  font-size: 30rpx;
  font-weight: 600;
}

.status-label {
  color: #444444;
  font-size: 25rpx;
  text-align: right;
}

.next-action {
  display: block;
  margin-top: 18rpx;
  color: #444444;
  font-size: 28rpx;
  line-height: 1.55;
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
  margin-top: 18rpx;
  color: #777777;
  font-size: 24rpx;
}

.feedback-state {
  margin-top: 100rpx;
  color: #666666;
  font-size: 28rpx;
  text-align: center;
}

.secondary-button {
  margin: 24rpx auto 0;
  padding: 0 24rpx;
  background: #ffffff;
  color: #333333;
  font-size: 28rpx;
  line-height: 64rpx;
}
