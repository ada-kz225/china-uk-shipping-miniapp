<view class="package-page">
  <view class="page-heading">
    <view>
      <text class="page-title">我的包裹</text>
      <text class="page-description">{{isSelectionMode ? '选择本次要转运的包裹' : '查看包裹到仓、确认和转运状态'}}</text>
    </view>
    <button wx:if="{{isSelectionMode}}" class="secondary-button heading-button" bindtap="onExitSelection">退出</button>
    <button wx:else class="declare-button" bindtap="onDeclareTap">预报包裹</button>
  </view>

  <scroll-view wx:if="{{!isSelectionMode}}" class="filter-bar" scroll-x="true" enable-flex="true">
    <view class="filter-items">
      <view
        wx:for="{{filters}}"
        wx:key="key"
        class="filter-item {{selectedFilter === item.key ? 'filter-item-active' : ''}}"
        data-filter="{{item.key}}"
        bindtap="onFilterTap"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{isLoading}}" class="feedback-state">
    <text>正在加载。</text>
  </view>

  <view wx:elif="{{errorMessage}}" class="feedback-state">
    <text class="feedback-message">{{errorMessage}}</text>
    <button class="secondary-button" bindtap="onRetryTap">重新加载</button>
  </view>

  <view wx:elif="{{packages.length === 0}}" class="feedback-state">
    <text wx:if="{{selectedFilter === 'all'}}">暂无包裹。下单后可预报国内运单号。</text>
    <text wx:else>该状态下暂无包裹。</text>
  </view>

  <view wx:else class="package-list">
    <view
      wx:for="{{packages}}"
      wx:key="id"
      class="package-card {{isSelectionMode && !item.isEligibleForShipment ? 'package-card-disabled' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCardTap"
    >
      <view class="card-header">
        <view class="card-title">
          <view wx:if="{{isSelectionMode}}" class="selection-mark {{item.isSelected ? 'selection-mark-active' : ''}} {{!item.isEligibleForShipment ? 'selection-mark-disabled' : ''}}">
            {{item.isSelected ? '✓' : ''}}
          </view>
          <text class="tracking-number">{{item.domesticTrackingNumber}}</text>
        </view>
        <text class="status-label">{{item.statusLabel}}</text>
      </view>
      <text class="package-description">{{item.description}}</text>
      <view class="card-meta">
        <text wx:if="{{item.arrivedAtDisplay}}">到仓：{{item.arrivedAtDisplay}}</text>
        <text wx:if="{{item.weightDisplay}}">重量：{{item.weightDisplay}}</text>
      </view>
      <view wx:if="{{item.shipmentReference}}" class="relation-note">
        已关联转运单：{{item.shipmentReference}}
      </view>
      <view wx:if="{{item.activeException}}" class="exception-note">
        {{item.activeException.title}}
      </view>
      <view wx:if="{{isSelectionMode && !item.isEligibleForShipment}}" class="unavailable-note">
        不可选：{{item.selectionReason}}
      </view>
    </view>
  </view>

  <view wx:if="{{!isSelectionMode && packages.length > 0 && !isLoading && !errorMessage}}" class="consolidation-entry">
    <button class="primary-button" bindtap="onStartConsolidation">开始合箱</button>
  </view>

  <view wx:if="{{isSelectionMode}}" class="selection-bottom-bar">
    <view>
      <text class="selection-count">已选择 {{selectedPackageIds.length}} 件</text>
      <text class="selection-hint">还有 {{readyPackageCount - selectedPackageIds.length}} 件可合箱包裹未选择</text>
    </view>
    <button
      class="selection-create-button"
      loading="{{isCreatingShipment}}"
      disabled="{{isCreatingShipment}}"
      bindtap="onCreateShipmentTap"
    >
      创建转运单
    </button>
  </view>
</view>
