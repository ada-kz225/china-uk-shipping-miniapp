<view class="home-page">
  <view class="page-heading">
    <text class="page-title">中英转运</text>
    <text class="page-description">查看当前待办、转运进度和仓库信息</text>
  </view>

  <view wx:if="{{isLoading}}" class="feedback-state">
    <text>正在加载首页…</text>
  </view>

  <view wx:elif="{{errorMessage}}" class="feedback-state">
    <text class="feedback-message">{{errorMessage}}</text>
    <button class="secondary-button" bindtap="onRetryTap">重新加载</button>
  </view>

  <block wx:elif="{{home}}">
    <view class="section">
      <text class="section-title">待处理事项</text>
      <view wx:if="{{home.actionRequired.length === 0}}" class="empty-card">
        当前没有需要处理的事项
      </view>
      <view
        wx:for="{{home.actionRequired}}"
        wx:key="title"
        class="action-card"
        data-target-type="{{item.target.type}}"
        data-shipment-id="{{item.target.shipmentId}}"
        data-filter="{{item.target.filter}}"
        bindtap="onActionTap"
      >
        <view>
          <text class="card-title">{{item.title}}</text>
          <text class="card-description">{{item.description}}</text>
        </view>
        <text class="card-arrow">›</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">当前运输</text>
      <view
        wx:if="{{home.currentJourney}}"
        class="journey-card"
        data-id="{{home.currentJourney.id}}"
        bindtap="onCurrentShipmentTap"
      >
        <text class="shipment-reference">{{home.currentJourney.reference}}</text>
        <text class="status-badge status-badge-{{home.currentJourney.statusTone}}">{{home.currentJourney.statusLabel}}</text>
        <text class="card-description">下一步：{{home.currentJourney.nextAction}}</text>
      </view>
      <view wx:else class="empty-card">当前没有运输中的转运单。发出后会在这里显示进度。</view>
    </view>

    <view class="section">
      <text class="section-title">包裹概览</text>
      <view class="overview-card">
        <view
          wx:for="{{packageOverviewItems}}"
          wx:key="filter"
          class="overview-row"
          data-filter="{{item.filter}}"
          bindtap="onPackageOverviewTap"
        >
          <text>{{item.label}}</text>
          <view class="overview-value"><text>{{item.count}} 件</text><text class="card-arrow">›</text></view>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">中国仓库信息</text>
      <view wx:if="{{home.warehouse}}" class="warehouse-card">
        <text class="card-title">{{home.warehouse.name}}</text>
        <text class="warehouse-line">收件人：{{home.warehouse.recipientName}}（{{home.warehouse.recipientCode}}）</text>
        <text class="warehouse-line">电话：{{home.warehouse.phone}}</text>
        <text class="warehouse-line">地址：{{home.warehouse.addressLine}}</text>
        <text wx:if="{{home.warehouse.instructions}}" class="warehouse-line">备注：{{home.warehouse.instructions}}</text>
        <button class="secondary-button copy-button" bindtap="onCopyWarehouseTap">复制仓库地址</button>
      </view>
      <view wx:else class="empty-card">暂未提供仓库信息。</view>
    </view>
  </block>
</view>
