<view class="detail-page">
  <view wx:if="{{isLoading}}" class="feedback-state">正在加载。</view>
  <view wx:elif="{{errorMessage}}" class="feedback-state">
    <text>{{errorMessage}}</text>
    <button class="secondary-button" bindtap="onRetryTap">重新加载</button>
  </view>

  <view wx:elif="{{shipment}}" class="detail-content">
    <view class="status-card">
      <text class="field-label">转运单号</text>
      <text class="reference">{{shipment.referenceDisplay}}</text>
      <text class="status-label">{{shipment.statusLabel}}</text>
      <text class="status-description">{{shipment.statusDescription}}</text>
      <view class="next-action">
        <text class="field-label">下一步</text>
        <text>{{shipment.nextAction}}</text>
      </view>
      <button wx:if="{{shipment.status === 'DRAFT'}}" class="draft-button" bindtap="onContinueDraftTap">继续完善本次转运</button>
    </view>

    <view wx:if="{{shipment.activeException}}" class="information-card exception-card">
      <text class="section-title">需要处理的问题</text>
      <view class="exception-row">
        <text class="field-label">发生什么</text>
        <text>{{shipment.activeException.title}}：{{shipment.activeException.description}}</text>
      </view>
      <view class="exception-row">
        <text class="field-label">影响什么</text>
        <text>{{shipment.activeException.impact}}</text>
      </view>
      <view class="exception-row">
        <text class="field-label">你需要做什么</text>
        <text>{{shipment.activeException.requiredAction}}</text>
      </view>
      <view class="exception-row">
        <text class="field-label">当前进度</text>
        <text>{{shipment.activeException.progress}}</text>
      </view>
      <view class="exception-row">
        <text class="field-label">需要帮助</text>
        <text>{{shipment.activeException.support}}</text>
      </view>
    </view>

    <view wx:if="{{shipment.trackingEventsDisplay.length > 0}}" class="information-card timeline-card">
      <view class="timeline-heading">
        <text class="section-title">运输进度</text>
        <text class="mock-note">模拟物流</text>
      </view>
      <view wx:for="{{shipment.trackingEventsDisplay}}" wx:key="occurredAtDisplay" class="timeline-item">
        <view class="timeline-marker">
          <view class="timeline-dot"></view>
          <view wx:if="{{index !== shipment.trackingEventsDisplay.length - 1}}" class="timeline-line"></view>
        </view>
        <view class="timeline-content">
          <view class="timeline-title-row">
            <text class="timeline-title">{{item.title}}</text>
            <text class="timeline-time">{{item.occurredAtDisplay}}</text>
          </view>
          <text class="timeline-description">{{item.description}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{shipment.quote}}" class="information-card quote-card">
      <view class="quote-heading">
        <text class="section-title">最终报价</text>
        <text class="mock-note">模拟报价</text>
      </view>
      <view class="quote-row">
        <text>最终重量</text>
        <text>{{shipment.quote.finalWeightDisplay}}</text>
      </view>
      <view class="quote-row">
        <text>最终计费重量</text>
        <text>{{shipment.quote.chargeableWeightDisplay}}</text>
      </view>
      <view class="quote-row">
        <text>运费</text>
        <text>{{shipment.quote.shippingFeeDisplay}}</text>
      </view>
      <view class="quote-row">
        <text>打包费</text>
        <text>{{shipment.quote.serviceFeeDisplay}}</text>
      </view>
      <view class="quote-row quote-total">
        <text>总价</text>
        <text>{{shipment.quote.totalAmountDisplay}}</text>
      </view>
      <text class="quote-time">报价生成时间：{{shipment.quoteGeneratedAtDisplay}}</text>

      <view wx:if="{{shipment.latestPayment && shipment.latestPayment.status === 'FAILED'}}" class="payment-note payment-note-failed">
        <text>{{shipment.latestPayment.statusLabel}}</text>
        <text>{{shipment.latestPayment.statusDescription}}</text>
      </view>
      <view wx:if="{{isPaying || shipment.status === 'PAYMENT_PROCESSING'}}" class="payment-note">
        <text>付款处理中</text>
        <text>正在确认付款结果，请勿重复操作。</text>
      </view>
      <button
        wx:if="{{shipment.status === 'AWAITING_PAYMENT'}}"
        class="payment-button"
        loading="{{isPaying}}"
        disabled="{{isPaying}}"
        bindtap="onPaymentTap"
      >
        {{isPaying ? '付款处理中' : '确认并模拟付款'}}
      </button>
      <view wx:if="{{shipment.status === 'PAID_AWAITING_DISPATCH'}}" class="payment-note payment-note-success">
        <text>费用已支付成功，仓库正在安排出库。</text>
        <text>当前无需操作，转运单尚未实际离开仓库。</text>
      </view>
    </view>

    <view class="information-card">
      <text class="section-title">包含的包裹</text>
      <view
        wx:for="{{shipment.packages}}"
        wx:key="id"
        class="package-row"
        data-id="{{item.id}}"
        bindtap="onPackageTap"
      >
        <view>
          <text class="tracking-number">{{item.domesticTrackingNumber}}</text>
          <text class="package-description">{{item.description}}</text>
        </view>
        <text class="package-status">{{item.statusLabel}}</text>
      </view>
    </view>

    <view class="information-card">
      <text class="section-title">英国收货地址</text>
      <view wx:if="{{shipment.address}}" class="address-content">
        <text>{{shipment.address.recipientName}}｜{{shipment.address.phone}}</text>
        <text>{{shipment.address.postcode}}</text>
        <text>{{shipment.address.addressLine}}</text>
      </view>
      <text wx:else class="empty-address">提交转运单前请填写英国收货地址。</text>
    </view>

    <view class="information-card">
      <text class="section-title">时间信息</text>
      <view class="time-row">
        <text class="field-label">创建时间</text>
        <text>{{shipment.createdAtDisplay}}</text>
      </view>
      <view wx:if="{{shipment.submittedAtDisplay}}" class="time-row">
        <text class="field-label">提交时间</text>
        <text>{{shipment.submittedAtDisplay}}</text>
      </view>
    </view>
  </view>
</view>
